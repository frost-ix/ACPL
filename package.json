{
  "name": "ACL",
  "version": "2.0.0",
  "description": "ACPL - Multi-folder OS Shell Integration supporting Anthropic Claude, Antigravity, and Codex CLI",
  "scripts": {
    "start": "cmd /c \"set PATH=%USERPROFILE%\\.cargo\\bin;%PATH% && npx tauri dev\"",
    "tauri:dev": "cmd /c \"set PATH=%USERPROFILE%\\.cargo\\bin;%PATH% && npx tauri dev\"",
    "tauri:build": "cmd /c \"set PATH=%USERPROFILE%\\.cargo\\bin;%PATH% && npx tauri build\""
  },
  "keywords": [
    "tauri",
    "powershell",
    "claude",
    "antigravity",
    "codex",
    "cli"
  ],
  "author": "성현우",
  "license": "MIT",
  "devDependencies": {
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/cli": "^2.2.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0"
  }
}
