{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ACPL",
  "version": "1.1.0",
  "identifier": "com.acpl.os-shell-launcher",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ACPL",
        "width": 1380,
        "height": 850,
        "minWidth": 980,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#0f172a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
